# Copy to .env for local runs. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# VERIFY the Live model location with backend/live_spike.py (asia-south1, global, us-central1)
GOOGLE_CLOUD_LOCATION=global

# Fallback when not using Vertex: set GOOGLE_GENAI_USE_VERTEXAI=false and provide an AI Studio key
GEMINI_API_KEY=

LIVE_MODEL=gemini-3.8-live
FLASH_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call the backend (empty = allow all, dev only)
ALLOWED_ORIGINS=http://localhost:5000
KILL_SWITCH=false
MAX_CALL_SECONDS=300
